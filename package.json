{
  "name": "collabsphere-root",
  "version": "1.0.0",
  "private": true,
  "description": "CollabSphere – AI-Powered Developer Collaboration Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "start": "node server/server.js",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "clean": "rm -rf client/dist dist build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.16.0"
  }
}
