# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/collabsphere

# JWT Secret for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_change_in_production_min32chars

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL (for CORS and public share link resolution)
CLIENT_URL=http://localhost:5173

# Application Environment (development | production | test)
NODE_ENV=development
